# NOMS DE VARIABLES SEULEMENT. Aucune valeur réelle ne doit figurer ici.
# Ce fichier est suivi par Git ; le `.env` réel ne l'est jamais.
# Les services refusent de démarrer si une variable requise manque, et le
# worker refuse de démarrer sur une valeur d'exemple (`CHANGE_ME`).

VERTEX_ENV=development

# PostgreSQL (conteneur `db`)
VERTEX_DB_USER=vertex
VERTEX_DB_PASSWORD=CHANGE_ME
VERTEX_DB_NAME=vertex
VERTEX_DB_PORT=5432

# DSN utilisé par l'API et le worker. Doit désigner le service `db`.
VERTEX_DATABASE_URL=postgresql+psycopg://vertex:CHANGE_ME@db:5432/vertex

# Ports publiés — sur 127.0.0.1 uniquement (voir compose.yaml).
VERTEX_API_PORT=8000
VERTEX_WEB_PORT=4173
