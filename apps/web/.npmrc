# Ne pas auto-installer les peers manquants : le peer `next` de geist (intégration
# Next.js) est inutilisé ici — seuls les fichiers woff2 OFL de geist sont consommés.
# Les peers réellement requis (react, react-dom) sont des dépendances directes épinglées.
auto-install-peers=false

# Supply-chain (.claude/rules/security.md) : toute dépendance ajoutée est
# épinglée EXACTEMENT, jamais par intervalle et jamais par `latest`.
save-exact=true
