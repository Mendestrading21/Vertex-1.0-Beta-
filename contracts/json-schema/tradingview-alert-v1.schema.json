{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex.local/schemas/tradingview-alert-v1.json",
  "title": "Vertex TradingView Alert v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "alert_id", "script_version", "sent_at", "bar_time", "exchange", "ticker", "interval", "signal"],
  "properties": {
    "schema": {"const": "vertex.tradingview.alert.v1"},
    "alert_id": {"type": "string", "minLength": 1, "maxLength": 120},
    "script_version": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}\\.[0-9]+$"},
    "sent_at": {"type": "string", "minLength": 1, "maxLength": 64},
    "bar_time": {"type": "string", "minLength": 1, "maxLength": 64},
    "exchange": {"type": "string", "minLength": 1, "maxLength": 32},
    "ticker": {"type": "string", "minLength": 1, "maxLength": 48},
    "interval": {"type": "string", "minLength": 1, "maxLength": 16},
    "signal": {"type": "string", "enum": ["SETUP", "BREAKOUT", "BREAKDOWN", "REGIME_CHANGE", "EVENT", "FUNDAMENTAL_UPDATE", "HEARTBEAT"]},
    "price": {"type": ["string", "null"], "pattern": "^-?[0-9]+(?:\\.[0-9]+)?$"},
    "values": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean", "null"]}, "maxProperties": 40}
  }
}

