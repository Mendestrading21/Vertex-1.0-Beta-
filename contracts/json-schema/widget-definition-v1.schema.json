{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vertex.local/schemas/widget-definition-v1.schema.json",
  "title": "Vertex Widget Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "version", "family", "question", "dominant_visual", "data_contracts", "states", "accessibility", "performance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "family": {"enum": ["DECISION", "MARKET", "COMPANY", "OPTIONS", "PORTFOLIO", "SYSTEM"]},
    "question": {"type": "string", "minLength": 10},
    "dominant_visual": {"enum": ["TEXT", "METRIC", "TABLE", "TIMELINE", "LINE", "CANDLE", "BAR", "HEATMAP", "SCATTER", "SURFACE", "PAYOFF", "GRAPH", "STATUS_MATRIX"]},
    "data_contracts": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "states": {
      "type": "array",
      "items": {"enum": ["LOADING", "LIVE", "DELAYED", "PARTIAL", "STALE", "OFFLINE", "EMPTY", "ERROR", "NOT_ENTITLED", "UNSUPPORTED"]},
      "allOf": [
        {"contains": {"const": "LOADING"}},
        {"contains": {"const": "LIVE"}},
        {"contains": {"const": "ERROR"}},
        {"contains": {"const": "EMPTY"}}
      ]
    },
    "accessibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_equivalent", "keyboard", "color_independent"],
      "properties": {
        "text_equivalent": {"type": "boolean", "const": true},
        "keyboard": {"type": "boolean", "const": true},
        "color_independent": {"type": "boolean", "const": true}
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial_payload_kb_max", "render_budget_ms", "virtualize_after_rows"],
      "properties": {
        "initial_payload_kb_max": {"type": "integer", "minimum": 1},
        "render_budget_ms": {"type": "integer", "minimum": 1},
        "virtualize_after_rows": {"type": "integer", "minimum": 1}
      }
    },
    "icon_id": {"type": ["string", "null"]},
    "allowed_pages": {"type": "array", "items": {"type": "string"}}
  }
}

