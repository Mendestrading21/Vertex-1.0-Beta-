# Noms seulement. Ne jamais mettre de vraies valeurs dans ce fichier.
VERTEX_ENV=development
# Forme SQLAlchemy OBLIGATOIRE (`postgresql+psycopg://`) : c'est celle qu'exige
# `create_engine`, et le pilote verrouillé est psycopg 3 — il n'y a aucun
# `psycopg2` dans uv.lock, donc la forme `postgresql://` fait échouer l'API et
# le worker au démarrage.
# Les outils libpq (pg_dump, pg_restore, psql) ne comprennent PAS cette forme
# et, pire, n'échouent pas dessus : ils la prennent pour un nom de base. Les
# scripts de `infra/backup/` la convertissent donc par `tools/db_url.py`, et
# vérifient auprès de la base elle-même qu'ils ont joint la bonne.
VERTEX_DATABASE_URL=postgresql+psycopg://vertex_api:CHANGE_ME@127.0.0.1:5432/vertex
VERTEX_TWS_HOST=127.0.0.1
VERTEX_TWS_PORT=7497
VERTEX_TWS_CLIENT_ID=71
VERTEX_CLOUDFLARE_QUEUE_ACCOUNT_ID=CHANGE_ME
VERTEX_CLOUDFLARE_QUEUE_TOKEN=CHANGE_ME
VERTEX_FRED_API_KEY=CHANGE_ME
VERTEX_SESSION_SECRET=CHANGE_ME
VERTEX_AI_PROVIDER=disabled

