# Noms seulement. Ne jamais mettre de vraies valeurs dans ce fichier.
#
# Ce fichier est le SEUL modèle du `.env` réel. `infra/compose/.env.example`
# déclarait auparavant un deuxième jeu de variables, avec un autre nom de rôle
# (`vertex` contre `vertex_api`) : deux vérités contradictoires, et aucune des
# deux ne provisionnait quoi que ce soit. Il n'en reste qu'une, ici.
#
#   docker compose -f infra/compose/compose.yaml --env-file .env up
VERTEX_ENV=development

# ---------------------------------------------------------------------------
# PostgreSQL — TROIS rôles distincts, jamais confondus
# ---------------------------------------------------------------------------
# `POSTGRES_USER` de l'image officielle PostgreSQL est un SUPERUTILISATEUR et
# devient propriétaire de tout ce que la première connexion crée. Tant que
# l'API et le worker s'en servaient, ils POSSÉDAIENT les tables append-only —
# et un propriétaire peut toujours exécuter
# `ALTER TABLE snapshots DISABLE TRIGGER snapshots_append_only` puis réécrire
# l'historique. Les déclencheurs de `0001`/`0003`/`0006` étaient donc
# auto-contournables par le rôle qui sert les requêtes.
#
# vertex_admin   AMORÇAGE. Superutilisateur. Crée les deux rôles ci-dessous au
#                premier démarrage, puis n'est plus jamais utilisé : ni par un
#                service, ni par les sauvegardes.
# vertex_migrate PROPRIÉTAIRE du schéma et des tables. Alembic seul (service
#                `migrate`). C'est le seul rôle capable de poser ou retirer un
#                déclencheur — c'est précisément son travail.
# vertex_api     RUNTIME (api + worker). Ne possède RIEN. Lit et insère ;
#                ne peut ni désactiver, ni retirer un déclencheur, ni créer un
#                objet dans `public`, ni poser `session_replication_role`.
#                Preuve exécutable : `infra/compose/check-least-privilege.sh`.
VERTEX_DB_NAME=vertex
VERTEX_DB_PORT=5432

VERTEX_DB_SUPERUSER=vertex_admin
VERTEX_DB_SUPERUSER_PASSWORD=CHANGE_ME

VERTEX_DB_MIGRATE_USER=vertex_migrate
VERTEX_DB_MIGRATE_PASSWORD=CHANGE_ME

VERTEX_DB_RUNTIME_USER=vertex_api
VERTEX_DB_RUNTIME_PASSWORD=CHANGE_ME

# Forme SQLAlchemy OBLIGATOIRE (`postgresql+psycopg://`) : c'est celle qu'exige
# `create_engine`, et le pilote verrouillé est psycopg 3 — il n'y a aucun
# `psycopg2` dans uv.lock, donc la forme `postgresql://` fait échouer l'API et
# le worker au démarrage.
# Les outils libpq (pg_dump, pg_restore, psql) ne comprennent PAS cette forme
# et, pire, n'échouent pas dessus : ils la prennent pour un nom de base. Les
# scripts de `infra/backup/` la convertissent donc par `tools/db_url.py`, et
# vérifient auprès de la base elle-même qu'ils ont joint la bonne.
#
# L'hôte `db` est le nom du service Compose : ces deux DSN sont ceux des
# CONTENEURS. Depuis la machine hôte (alembic à la main, `infra/backup/*.sh`,
# `check-least-privilege.sh`), remplacer `db` par `127.0.0.1` et le port par
# VERTEX_DB_PORT.
VERTEX_DATABASE_URL=postgresql+psycopg://vertex_api:CHANGE_ME@db:5432/vertex
VERTEX_MIGRATION_DATABASE_URL=postgresql+psycopg://vertex_migrate:CHANGE_ME@db:5432/vertex

# ---------------------------------------------------------------------------
# Sauvegardes — `infra/backup/backup.sh` et `verify-restore.sh`
# ---------------------------------------------------------------------------
# La phrase de chiffrement ne vit JAMAIS dans un fichier suivi par Git, et pas
# davantage dans le `.env` si celui-ci est monté dans un conteneur : elle est
# fournie à l'exécution. La base de vérification doit porter un marqueur
# `restore` / `verify` / `scratch` dans son nom, sans quoi le script refuse.
# VERTEX_BACKUP_DIR=/chemin/hors/depot
# VERTEX_BACKUP_PASSPHRASE=CHANGE_ME
# VERTEX_RESTORE_DATABASE_URL=postgresql+psycopg://vertex_migrate:CHANGE_ME@127.0.0.1:5432/vertex_restore_probe

# ---------------------------------------------------------------------------
# Ports publiés — sur 127.0.0.1 uniquement (voir infra/compose/compose.yaml)
# ---------------------------------------------------------------------------
VERTEX_API_PORT=8000
VERTEX_WEB_PORT=4173

# ---------------------------------------------------------------------------
# Sources et secrets applicatifs
# ---------------------------------------------------------------------------
# Commutateur du worker : `synthetic` (défaut) ou `real`. Il est lu par
# `vertex_worker.profiles.resolve_profile`. Le réel exige EN PLUS un univers
# déclaré (VERTEX_IBKR_UNIVERSE) : il ne s'active jamais par omission.
VERTEX_FUSION_PROFILE=synthetic
# Port du socket API de TWS, tel que CONFIRMÉ dans TWS — jamais supposé.
# Il n'existe AUCUNE variable d'hôte : `vertex_edge_ibkr.adapter` fixe
# 127.0.0.1 en dur et refuse tout autre hôte. Ne pas offrir le réglage est
# plus fort que le valider.
VERTEX_IBKR_PORT=7497
VERTEX_IBKR_CLIENT_ID=71
# Fichier d'univers JSON, HORS du dépôt : il nomme les instruments réellement
# suivis, donc une donnée personnelle. Voir docs/08-runbooks/IBKR_SETUP.md.
VERTEX_IBKR_UNIVERSE=
VERTEX_CLOUDFLARE_QUEUE_ACCOUNT_ID=CHANGE_ME
VERTEX_CLOUDFLARE_QUEUE_TOKEN=CHANGE_ME
# SEC EDGAR n'exige pas de clé, mais impose un User-Agent qui identifie
# l'application et un contact. Remplacer l'exemple uniquement dans le `.env`
# local, jamais ici avec une adresse personnelle réelle.
VERTEX_SEC_USER_AGENT=Vertex-One/1.0 contact@example.invalid
VERTEX_FRED_API_KEY=CHANGE_ME
# Facultatif : OpenFIGI fonctionne sans clé avec un quota réduit. Laisser vide
# tant qu'une clé n'a pas été créée depuis le compte OpenFIGI officiel.
VERTEX_OPENFIGI_API_KEY=
VERTEX_OFFICIAL_SOURCE_TIMEOUT_SECONDS=15
VERTEX_SESSION_SECRET=CHANGE_ME
VERTEX_AI_PROVIDER=disabled
